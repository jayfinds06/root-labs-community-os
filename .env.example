# Copy this file to .env and provide your own values.
# Generate the auth secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Used only by bun run db:seed-admin. No default credentials are provided.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Optional for local UI development; required for Discord ingestion.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_MONITORED_CHANNEL_IDS=
DISCORD_MESSAGE_CONTENT_INTENT=false
DISCORD_BACKFILL_DAYS=14
DISCORD_INCREMENTAL_BACKFILL_DAYS=1
DISCORD_INCREMENTAL_SYNC_ENABLED=true

# Required for live AI sentiment classification and AI chat.
ANTHROPIC_API_KEY=
